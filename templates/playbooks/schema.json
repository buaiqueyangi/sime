{
  "$id": "https://sime.dev/schemas/playbook-1.0.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SIME SOAR Playbook",
  "type": "object",
  "required": ["id", "name", "version", "trigger", "steps"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^pb\\.[a-z0-9-]+(\\.[a-z0-9-]+)+$" },
    "name": { "type": "string", "minLength": 4, "maxLength": 60 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+$" },
    "status": { "enum": ["draft", "stable", "deprecated"] },
    "trigger": {
      "type": "object",
      "required": ["rules"],
      "additionalProperties": false,
      "properties": {
        "rules": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^rule\\.[a-z0-9]+(\\.[a-z0-9-]+)+$" } },
        "min_severity": { "enum": ["info", "low", "medium", "high", "critical"] }
      }
    },
    "steps": {
      "type": "array", "minItems": 1,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_.]*(\\([^()]{0,200}\\))?$" }
    }
  }
}
