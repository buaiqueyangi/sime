{
  "$id": "https://sime.dev/schemas/adapter-1.0.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SIME Log Source Adapter (three layers)",
  "description": "适配库三层结构：parse(解析) → mapping(字段映射到 ECS 基线) → threat_map(威胁类型归一)",
  "type": "object",
  "required": ["id", "vendor", "product", "protocol", "parse", "mapping", "sample"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^adapter\\.[a-z0-9]+(\\.[a-z0-9-]+)+$" },
    "vendor": { "type": "string", "minLength": 2 },
    "product": { "type": "string", "minLength": 2 },
    "vendor_doc": { "type": "string", "description": "厂商 syslog/接口文档出处" },
    "protocol": { "enum": ["syslog-udp", "syslog-tcp", "syslog-tls", "json-http", "file", "mqtt", "modbus-audit", "opcua-audit"] },
    "parse": {
      "type": "object",
      "required": ["format"],
      "additionalProperties": false,
      "properties": {
        "format": { "enum": ["regex", "json", "kv", "cef", "lef"] },
        "template": { "type": "string", "description": "regex 格式含命名捕获组 (?<name>...)；kv 格式含占位符模板" }
      }
    },
    "mapping": {
      "type": "object",
      "minProperties": 1,
      "description": "目标字段为 ECS 基线 + sime.* 扩展；值为捕获组引用 <name>、JSON 路径 $.x、或 lookup:<key>",
      "additionalProperties": { "type": "string" }
    },
    "threat_map": {
      "type": "object",
      "description": "厂商规则ID/事件类型 → SIME 威胁字典（sime.tht.*），映射在 mapping 中以 lookup: 引用",
      "additionalProperties": { "type": "string", "pattern": "^sime\\.tht\\.[a-z0-9-]+$" }
    },
    "normalize": {
      "type": "object",
      "description": "值归一化：字段 → {from: to} 字典，如 event.outcome: {允许: allow, 阻断: deny}",
      "additionalProperties": { "type": "object", "additionalProperties": { "type": "string" } }
    },
    "sample": { "type": "string", "minLength": 5, "description": "原始样例日志（CI 用样例驱动回归）" }
  }
}
